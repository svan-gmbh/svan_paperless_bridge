#: svan_paperless_bridge/svan_paperless_ngx_bridge/doctype/svan_paperless_custom_field_source/svan_paperless_custom_field_source.py:55
#, python-brace-format
msgid "'{0}' is not a valid field on '{1}'. For Source Fieldname, use the technical fieldname (not the field label)."
msgstr "'{0}' ist kein gültiges Feld an '{1}'. Bitte bei Quell-Feldname den technischen Feldnamen verwenden (nicht das Feld-Label)."

#: svan_paperless_bridge/svan_paperless_ngx_bridge/doctype/svan_paperless_whitelisted_doctype/svan_paperless_whitelisted_doctype.py:126
#, python-brace-format
msgid "'{0}' on '{1}' is not a link field. Party Fieldname must link to the party master record (e.g. Customer/Supplier)."
